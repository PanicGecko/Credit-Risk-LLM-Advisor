# ──────────────────────────────────────────────────────────────────
# Credit Risk LLM Advisor — Environment Variables
# ──────────────────────────────────────────────────────────────────
# Quick start:
#   cp .env.example .env
#   # Then edit .env and paste your real key below.
#
# NEVER commit the real .env file to Git.

# OpenAI API key (required for the LLM interface)
# Get one at https://platform.openai.com/api-keys
MODEL_API_KEY=sk-your-key-here

# OpenAI model to use (default: gpt-4o-mini)
MODEL_NAME=gpt-4o-mini

# Max tokens for LLM responses
LLM_MAX_TOKENS=1024

# Path to the trained pipeline artifact (default: models/pipeline.pkl)
# MODEL_PATH=models/pipeline.pkl
